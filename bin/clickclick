#!/usr/bin/env bash
# ==============================================================================
# CLICKCLICK - HIGH-PERFORMANCE KEYBOARD & MOUSE ACOUSTIC FEEDBACK (evdev + PipeWire)
# ==============================================================================

set -euo pipefail
trap cleanup EXIT INT TERM

readonly APP_NAME="clickclick"
readonly CONFIG_ENABLE_TRACKPADS="false"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

# Discover ClickClick binary
BIN_PATH=""
if command -v clickclick >/dev/null && [[ "$(command -v clickclick)" != "${BASH_SOURCE[0]}" ]]; then
    BIN_PATH="$(command -v clickclick)"
elif [[ -x "$REPO_DIR/target/release/clickclick" ]]; then
    BIN_PATH="$REPO_DIR/target/release/clickclick"
elif [[ -x "/usr/local/bin/clickclick" ]]; then
    BIN_PATH="/usr/local/bin/clickclick"
elif [[ -x "$REPO_DIR/target/release/clickclick_rs" ]]; then
    BIN_PATH="$REPO_DIR/target/release/clickclick_rs"
elif [[ -x "/usr/bin/clickclick" ]]; then
    BIN_PATH="/usr/bin/clickclick"
fi

readonly CONFIG_DIR="$HOME/.config/clickclick"
readonly PRESETS_DIR="${CONFIG_DIR}/presets"
readonly ACTIVE_LINK="${CONFIG_DIR}/active"
readonly ACTIVE_FILE="${CONFIG_DIR}/active_preset.txt"
readonly SINK_FILE="${CONFIG_DIR}/sink_mode.txt"
readonly VOLUME_FILE="${CONFIG_DIR}/volume.txt"
readonly HUMANIZE_FILE="${CONFIG_DIR}/humanize.txt"

# --- ANSI COLORS ---
readonly C_RED=$'\033[1;31m'
readonly C_GREEN=$'\033[1;32m'
readonly C_BLUE=$'\033[1;34m'
readonly C_CYAN=$'\033[1;36m'
readonly C_YELLOW=$'\033[1;33m'
readonly C_DIM=$'\033[2m'
readonly C_RESET=$'\033[0m'

cleanup() {
    tput cnorm 2>/dev/null || true
    return 0
}

if [[ $EUID -eq 0 ]]; then
    printf "%b[CRITICAL]%b Do not run this script as root. Run as normal user.\n" "${C_RED}" "${C_RESET}"
    exit 1
fi

notify_user() {
    if command -v notify-send >/dev/null; then
        notify-send --app-name="ClickClick" "ClickClick" "$1"
    fi
}

get_active_preset() {
    if [[ -f "$ACTIVE_FILE" ]]; then
        cat "$ACTIVE_FILE"
    elif [[ -L "$ACTIVE_LINK" ]]; then
        basename "$(readlink "$ACTIVE_LINK")"
    else
        echo "nk_cream"
    fi
}

ensure_presets_installed() {
    if [[ ! -d "$PRESETS_DIR" || -z "$(ls -A "$PRESETS_DIR" 2>/dev/null)" ]]; then
        mkdir -p "$PRESETS_DIR"
        if [[ -d "$REPO_DIR/presets" ]]; then
            cp -r "$REPO_DIR/presets"/* "$PRESETS_DIR"/
        elif [[ -d "/usr/local/share/clickclick/presets" ]]; then
            cp -r /usr/local/share/clickclick/presets/* "$PRESETS_DIR"/
        elif [[ -d "/usr/share/clickclick/presets" ]]; then
            cp -r /usr/share/clickclick/presets/* "$PRESETS_DIR"/
        fi
    fi
}

ensure_active_preset() {
    ensure_presets_installed
    local active_name
    active_name=$(get_active_preset)
    if [[ ! -d "${PRESETS_DIR}/${active_name}" ]]; then
        active_name="nk_cream"
        if [[ ! -d "${PRESETS_DIR}/${active_name}" ]]; then
            active_name=$(ls -1 "$PRESETS_DIR" 2>/dev/null | head -n 1 || echo "")
        fi
    fi
    if [[ -n "$active_name" && -d "${PRESETS_DIR}/${active_name}" ]]; then
        ln -snf "presets/${active_name}" "$ACTIVE_LINK"
        echo "$active_name" > "$ACTIVE_FILE"
    fi
}

get_sink_mode() {
    if [[ -f "$SINK_FILE" ]]; then
        cat "$SINK_FILE"
    else
        echo "direct"
    fi
}

set_sink_mode() {
    local mode="$1"
    case "$mode" in
        direct|hardware|hw)
            echo "direct" > "$SINK_FILE"
            notify_user "Audio Routing: Direct Hardware DAC (0 ms)"
            printf "%b[SINK]%b Audio Routing: Direct physical DAC / Headphone Amp\n" "${C_GREEN}" "${C_RESET}"
            ;;
        surround|3d|spatial)
            echo "surround" > "$SINK_FILE"
            notify_user "Audio Routing: 3D HRTF Virtual Surround (7.1)"
            printf "%b[SINK]%b Audio Routing: 3D HRTF Virtual Surround\n" "${C_CYAN}" "${C_RESET}"
            ;;
        default|system|auto)
            echo "default" > "$SINK_FILE"
            notify_user "Audio Routing: Default System Output"
            printf "%b[SINK]%b Audio Routing: Following System Default\n" "${C_YELLOW}" "${C_RESET}"
            ;;
        *)
            printf "%b[ERROR]%b Invalid sink mode '%s'. Allowed: direct, surround, default\n" "${C_RED}" "${C_RESET}" "$mode"
            exit 1
            ;;
    esac
    if pgrep -x "clickclick" >/dev/null || pgrep -x "clickclick_rs" >/dev/null; then
        start_engine
    fi
}

get_volume() {
    if [[ -f "$VOLUME_FILE" ]]; then
        cat "$VOLUME_FILE"
    else
        echo "0.75"
    fi
}

set_volume() {
    local raw="$1"
    local parsed="0.75"
    if [[ "$raw" =~ ^[0-9]+$ ]]; then
        if (( raw > 1 )); then
            parsed=$(python3 -c "print(min(2.0, max(0.0, $raw / 100.0)))" 2>/dev/null || echo "0.75")
        else
            parsed="$raw"
        fi
    elif [[ "$raw" =~ ^[0-9]*\.[0-9]+$ ]]; then
        parsed=$(python3 -c "print(min(2.0, max(0.0, float('$raw'))))" 2>/dev/null || echo "0.75")
    fi

    echo "$parsed" > "$VOLUME_FILE"
    local pct
    pct=$(python3 -c "print(int(round(float('$parsed') * 100)))" 2>/dev/null || echo "75")
    printf "%b[VOLUME]%b Volume set to: %s (%s%%)\n" "${C_GREEN}" "${C_RESET}" "$parsed" "$pct"

    # Send SIGUSR2 to hot-reload without restart
    pkill -USR2 -x "clickclick" 2>/dev/null || pkill -USR2 -x "clickclick_rs" 2>/dev/null || true
}

get_humanize() {
    if [[ -f "$HUMANIZE_FILE" ]]; then
        cat "$HUMANIZE_FILE"
    else
        echo "true"
    fi
}

set_humanize() {
    local val="$1"
    local cur
    cur=$(get_humanize)
    local next="true"
    case "$val" in
        on|true|1|enable)
            next="true"
            ;;
        off|false|0|disable)
            next="false"
            ;;
        toggle)
            if [[ "$cur" == "true" ]]; then next="false"; else next="true"; fi
            ;;
    esac
    echo "$next" > "$HUMANIZE_FILE"
    if [[ "$next" == "true" ]]; then
        notify_user "Humanization: Enabled"
        printf "%b[HUMANIZE]%b Organic keystroke variation: Enabled (Pitch & Velocity jitter)\n" "${C_GREEN}" "${C_RESET}"
    else
        notify_user "Humanization: Disabled"
        printf "%b[HUMANIZE]%b Organic keystroke variation: Disabled\n" "${C_YELLOW}" "${C_RESET}"
    fi
    pkill -USR2 -x "clickclick" 2>/dev/null || pkill -USR2 -x "clickclick_rs" 2>/dev/null || true
}

get_hardware_sink() {
    if command -v pw-dump >/dev/null; then
        pw-dump Node 2>/dev/null | python3 -c '
import sys, json
try:
    nodes = json.load(sys.stdin)
    for n in nodes:
        props = n.get("info", {}).get("props", {})
        if props.get("media.class") == "Audio/Sink":
            name = props.get("node.name", "")
            if "virtual-surround" not in name and "effect_" not in name and "filter-chain" not in name:
                print(name)
                sys.exit(0)
except Exception:
    pass
' || echo ""
    fi
}

show_status() {
    ensure_active_preset
    local active
    active=$(get_active_preset)
    local running="No"
    local pid=""
    if pgrep -x "clickclick" >/dev/null || pgrep -x "clickclick_rs" >/dev/null; then
        running="Yes"
        pid=$(pgrep -x "clickclick" 2>/dev/null || pgrep -x "clickclick_rs" 2>/dev/null | head -n 1)
    fi
    local smode
    smode=$(get_sink_mode)
    local vol
    vol=$(get_volume)
    local vol_pct
    vol_pct=$(python3 -c "print(int(float('$vol') * 100))" 2>/dev/null || echo "75")
    local hum
    hum=$(get_humanize)
    local mouse="true"
    if [[ -f "${CONFIG_DIR}/enable_mice.txt" ]]; then
        mouse=$(cat "${CONFIG_DIR}/enable_mice.txt")
    fi

    printf "%b=== CLICKCLICK STATUS ===%b\n" "${C_CYAN}" "${C_RESET}"
    printf "  Running:       %b%s%b %s\n" "${C_GREEN}" "$running" "${C_RESET}" "${pid:+(PID: $pid)}"
    printf "  Preset:        %b%s%b\n" "${C_CYAN}" "$active" "${C_RESET}"
    printf "  Audio Routing: %b%s%b\n" "${C_YELLOW}" "$smode" "${C_RESET}"
    printf "  Volume:        %s (%s%%)\n" "$vol" "$vol_pct"
    printf "  Humanization:  %s\n" "$hum"
    printf "  Mouse Clicks:  %s\n" "$mouse"
}

reload_stream() {
    if pgrep -x "clickclick" >/dev/null || pgrep -x "clickclick_rs" >/dev/null; then
        pkill -USR1 -x "clickclick" 2>/dev/null || pkill -USR1 -x "clickclick_rs" 2>/dev/null || true
        printf "%b[RELOAD]%b Stream re-anchored to audio sink (SIGUSR1).\n" "${C_GREEN}" "${C_RESET}"
        notify_user "Audio stream synchronized"
    else
        start_engine
    fi
}

list_presets() {
    ensure_active_preset
    local active
    active=$(get_active_preset)
    printf "%b[CLICKCLICK PRESETS]%b\n" "${C_CYAN}" "${C_RESET}"
    if [[ -d "$PRESETS_DIR" ]]; then
        for p in "$PRESETS_DIR"/*; do
            if [[ -d "$p" ]]; then
                local name
                name=$(basename "$p")
                if [[ "$name" == "$active" ]]; then
                    printf "  %b* %s (active)%b\n" "${C_GREEN}" "$name" "${C_RESET}"
                else
                    printf "    %s\n" "$name"
                fi
            fi
        done
    fi
}

set_preset() {
    local target="$1"
    if [[ ! -d "${PRESETS_DIR}/${target}" ]]; then
        printf "%b[ERROR]%b Preset '%s' not found in %s\n" "${C_RED}" "${C_RESET}" "$target" "$PRESETS_DIR"
        notify_user "Preset '$target' not found!"
        exit 1
    fi

    ln -snf "presets/${target}" "$ACTIVE_LINK"
    echo "$target" > "$ACTIVE_FILE"

    printf "%b[PRESET]%b Switched active preset to: %b%s%b\n" "${C_GREEN}" "${C_RESET}" "${C_CYAN}" "$target" "${C_RESET}"

    if pgrep -x "clickclick" >/dev/null || pgrep -x "clickclick_rs" >/dev/null; then
        pkill -x "clickclick" 2>/dev/null || true
        pkill -x "clickclick_rs" 2>/dev/null || true
        while pgrep -x "clickclick" >/dev/null || pgrep -x "clickclick_rs" >/dev/null; do sleep 0.1; done
        start_engine
    fi
}

start_engine() {
    if ! groups "$USER" 2>/dev/null | grep -q "\binput\b"; then
        printf "%b[WARN]%b User is not in 'input' group. You may need: sudo usermod -aG input $USER\n" "${C_YELLOW}" "${C_RESET}"
    fi

    ensure_active_preset
    local active_name
    active_name=$(get_active_preset)
    
    local target_dir="${ACTIVE_LINK}"
    if [[ ! -f "${target_dir}/config.json" ]]; then
        target_dir="${CONFIG_DIR}"
    fi

    if [[ ! -f "${target_dir}/config.json" ]]; then
        printf "\n%b[ACTION REQUIRED]%b Missing config.json in preset!\n" "${C_YELLOW}" "${C_RESET}"
        notify_user "Missing config.json in preset: $active_name"
        exit 1
    fi

    if [[ -z "$BIN_PATH" || ! -x "$BIN_PATH" ]]; then
        printf "%b[BUILD]%b Compiling ClickClick in Rust (Release Mode)...\n" "${C_YELLOW}" "${C_RESET}"
        cd "$REPO_DIR"
        if command -v nix-shell >/dev/null; then
            nix-shell -p cargo rustc pkg-config alsa-lib --run "cargo build --release"
        elif command -v cargo >/dev/null; then
            cargo build --release
        else
            printf "%b[ERROR]%b cargo command not found.\n" "${C_RED}" "${C_RESET}"
            exit 1
        fi
        BIN_PATH="$REPO_DIR/target/release/clickclick"
    fi

    local enable_mice_val="true"
    if [[ -f "${CONFIG_DIR}/enable_mice.txt" ]]; then
        enable_mice_val=$(cat "${CONFIG_DIR}/enable_mice.txt")
    fi

    local sink_mode_val
    sink_mode_val=$(get_sink_mode)

    if [[ "$sink_mode_val" == "direct" ]]; then
        local hw_sink
        hw_sink=$(get_hardware_sink)
        if [[ -n "$hw_sink" ]]; then
            export PIPEWIRE_PROPS="{ target.object = \"$hw_sink\" }"
            printf "%b[AUDIO]%b Direct hardware link: %s\n" "${C_GREEN}" "${C_RESET}" "$hw_sink"
        else
            unset PIPEWIRE_PROPS 2>/dev/null || true
        fi
    elif [[ "$sink_mode_val" == "surround" ]]; then
        export PIPEWIRE_PROPS='{ target.object = "effect_input.virtual-surround-7.1-hesuvi" }'
        printf "%b[AUDIO]%b 3D Virtual Surround link\n" "${C_CYAN}" "${C_RESET}"
    else
        unset PIPEWIRE_PROPS 2>/dev/null || true
        printf "%b[AUDIO]%b Default system audio sink\n" "${C_YELLOW}" "${C_RESET}"
    fi

    local vol_val
    vol_val=$(get_volume)
    export CLICKCLICK_VOLUME="$vol_val"

    local hum_val
    hum_val=$(get_humanize)
    export CLICKCLICK_HUMANIZE="$hum_val"

    printf "%b[RUN]%b Starting ClickClick engine (Preset: %b%s%b, Routing: %s, Volume: %s)...\n" "${C_BLUE}" "${C_RESET}" "${C_CYAN}" "$active_name" "${C_RESET}" "$sink_mode_val" "$vol_val"
    notify_user "Active: $active_name ($sink_mode_val)"

    export ENABLE_TRACKPADS="$CONFIG_ENABLE_TRACKPADS"
    export ENABLE_MICE="$enable_mice_val"
    export PIPEWIRE_LATENCY="64/48000"

    pkill -x "clickclick" 2>/dev/null || true
    pkill -x "clickclick_rs" 2>/dev/null || true
    while pgrep -x "clickclick" >/dev/null || pgrep -x "clickclick_rs" >/dev/null; do sleep 0.1; done

    nohup "$BIN_PATH" "$target_dir" >/tmp/clickclick.log 2>&1 &
    sleep 0.2

    if pgrep -x "clickclick" >/dev/null || pgrep -x "clickclick_rs" >/dev/null; then
        printf "%b[OK]%b Engine running in background.\n" "${C_GREEN}" "${C_RESET}"
    else
        printf "%b[ERROR]%b Engine failed to start. Log output:\n" "${C_RED}" "${C_RESET}"
        tail -n 10 /tmp/clickclick.log || true
        exit 1
    fi
}

open_gui() {
    local gui_script="$REPO_DIR/ui/clickclick_gui.py"
    if [[ ! -f "$gui_script" ]]; then
        gui_script="/usr/local/bin/clickclick-settings"
    fi
    if [[ ! -f "$gui_script" ]]; then
        gui_script="/usr/bin/clickclick-settings"
    fi
    if command -v python3 >/dev/null && [[ -f "$gui_script" ]]; then
        python3 "$gui_script" &
    elif command -v clickclick-settings >/dev/null; then
        clickclick-settings &
    else
        printf "%b[ERROR]%b GUI application not found.\n" "${C_RED}" "${C_RESET}"
        exit 1
    fi
}

test_click() {
    ensure_active_preset
    local sound_file="${ACTIVE_LINK}/space.wav"
    if [[ ! -f "$sound_file" ]]; then sound_file="${ACTIVE_LINK}/enter.wav"; fi
    if [[ ! -f "$sound_file" ]]; then sound_file=$(ls -1 "${ACTIVE_LINK}"/*.wav 2>/dev/null | head -n 1 || echo ""); fi
    if [[ -n "$sound_file" && -f "$sound_file" ]]; then
        printf "%b[TEST]%b Playing click sample: %s\n" "${C_CYAN}" "${C_RESET}" "$sound_file"
        pw-play "$sound_file" 2>/dev/null || paplay "$sound_file" 2>/dev/null || aplay "$sound_file" 2>/dev/null || true
    else
        printf "%b[ERROR]%b No sound samples found in active preset.\n" "${C_RED}" "${C_RESET}"
    fi
}

# --- CLI DISPATCH ---
CMD="${1:-toggle}"

case "$CMD" in
    gui|settings|config)
        open_gui
        exit 0
        ;;
    list|ls)
        list_presets
        exit 0
        ;;
    preset|switch)
        if [[ -z "${2:-}" ]]; then
            list_presets
            exit 0
        fi
        set_preset "$2"
        exit 0
        ;;
    test|play)
        test_click
        exit 0
        ;;
    sink|routing)
        if [[ -z "${2:-}" ]]; then
            printf "Current Audio Routing: %s\n" "$(get_sink_mode)"
            exit 0
        fi
        set_sink_mode "$2"
        exit 0
        ;;
    vol|volume)
        if [[ -z "${2:-}" ]]; then
            printf "Current Volume: %s\n" "$(get_volume)"
            exit 0
        fi
        set_volume "$2"
        exit 0
        ;;
    humanize|pitch)
        set_humanize "${2:-toggle}"
        exit 0
        ;;
    reload|refresh)
        reload_stream
        exit 0
        ;;
    status|info)
        show_status
        exit 0
        ;;
    start)
        start_engine
        exit 0
        ;;
    stop)
        pkill -x "clickclick" 2>/dev/null || true
        pkill -x "clickclick_rs" 2>/dev/null || true
        notify_user "Disabled"
        printf "%b[STOP]%b ClickClick stopped.\n" "${C_YELLOW}" "${C_RESET}"
        exit 0
        ;;
    toggle)
        if pgrep -x "clickclick" >/dev/null || pgrep -x "clickclick_rs" >/dev/null; then
            printf "%b[TOGGLE]%b Stopping active instance...\n" "${C_YELLOW}" "${C_RESET}"
            pkill -x "clickclick" 2>/dev/null || true
            pkill -x "clickclick_rs" 2>/dev/null || true
            notify_user "Disabled"
            exit 0
        else
            start_engine
        fi
        ;;
    help|--help|-h)
        printf "%bClickClick%b — Mechanical Keyboard Acoustics CLI\n" "${C_GREEN}" "${C_RESET}"
        printf "Usage: clickclick [command] [args]\n\n"
        printf "Commands:\n"
        printf "  gui               Open Libadwaita settings application\n"
        printf "  start             Start background audio engine\n"
        printf "  stop              Stop background audio engine\n"
        printf "  toggle            Toggle engine on/off\n"
        printf "  status            Display engine status, routing, and volume\n"
        printf "  list              List available switch presets\n"
        printf "  preset <name>     Switch active preset (e.g. nk_cream)\n"
        printf "  volume <0-100>    Set feedback volume level\n"
        printf "  humanize [on|off] Toggle organic pitch & velocity micro-jitter\n"
        printf "  sink <mode>       Set routing: direct, surround, or default\n"
        printf "  test              Play a test click from active preset\n"
        exit 0
        ;;
    *)
        if [[ -d "${PRESETS_DIR}/${CMD}" ]]; then
            set_preset "$CMD"
        else
            printf "%b[ERROR]%b Unknown command or preset '%s'.\n" "${C_RED}" "${C_RESET}" "$CMD"
            list_presets
            exit 1
        fi
        ;;
esac
