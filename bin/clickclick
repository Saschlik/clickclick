#!/usr/bin/env bash
# ==============================================================================
# CLICKCLICK - LOW-LATENCY KEYBOARD & MOUSE ACOUSTIC FEEDBACK (evdev + PipeWire)
# ==============================================================================

set -euo pipefail
trap cleanup EXIT INT TERM

readonly APP_NAME="clickclick"
readonly CONFIG_ENABLE_TRACKPADS="false"

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

# Discover ClickClick daemon binary (clickclickd)
BIN_PATH=""
if [[ -x "$SCRIPT_DIR/clickclickd" ]]; then
    BIN_PATH="$SCRIPT_DIR/clickclickd"
elif command -v clickclickd >/dev/null 2>&1; then
    BIN_PATH="$(command -v clickclickd)"
elif [[ -x "$REPO_DIR/target/release/clickclickd" ]]; then
    BIN_PATH="$REPO_DIR/target/release/clickclickd"
elif [[ -x "/usr/local/bin/clickclickd" ]]; then
    BIN_PATH="/usr/local/bin/clickclickd"
elif [[ -x "/usr/bin/clickclickd" ]]; then
    BIN_PATH="/usr/bin/clickclickd"
elif [[ -x "$REPO_DIR/target/release/clickclick_rs" ]]; then
    BIN_PATH="$REPO_DIR/target/release/clickclick_rs"
fi

readonly CONFIG_DIR="$HOME/.config/clickclick"
readonly PRESETS_DIR="${CONFIG_DIR}/presets"
readonly ACTIVE_LINK="${CONFIG_DIR}/active"
readonly ACTIVE_FILE="${CONFIG_DIR}/active_preset.txt"
readonly SINK_FILE="${CONFIG_DIR}/sink_mode.txt"
readonly VOLUME_FILE="${CONFIG_DIR}/volume.txt"
readonly HUMANIZE_FILE="${CONFIG_DIR}/humanize.txt"
readonly MICE_FILE="${CONFIG_DIR}/enable_mice.txt"
readonly PID_FILE="${CONFIG_DIR}/daemon.pid"

# --- ANSI COLORS ---
readonly C_RED=$'\033[1;31m'
readonly C_GREEN=$'\033[1;32m'
readonly C_BLUE=$'\033[1;34m'
readonly C_CYAN=$'\033[1;36m'
readonly C_YELLOW=$'\033[1;33m'
readonly C_DIM=$'\033[2m'
readonly C_RESET=$'\033[0m'

cleanup() {
    tput cnorm 2>/dev/null || true
    return 0
}

if [[ $EUID -eq 0 ]]; then
    printf "%b[CRITICAL]%b Do not run this script as root. Run as normal user.\n" "${C_RED}" "${C_RESET}"
    exit 1
fi

notify_user() {
    if command -v notify-send >/dev/null 2>&1; then
        notify-send --app-name="ClickClick" "ClickClick" "$1"
    fi
}

get_daemon_pids() {
    local pids=()
    if [[ -f "$PID_FILE" ]]; then
        local fpid
        fpid="$(tr -d '[:space:]' < "$PID_FILE" 2>/dev/null || true)"
        if [[ "$fpid" =~ ^[0-9]+$ ]] && kill -0 "$fpid" 2>/dev/null; then
            if tr '\0' ' ' < "/proc/$fpid/cmdline" 2>/dev/null | grep -qi "clickclick"; then
                pids+=("$fpid")
            fi
        fi
    fi
    while IFS= read -r p; do
        [[ -z "$p" || "$p" == "$$" ]] && continue
        local dup=0
        for existing in "${pids[@]:-}"; do
            [[ "$existing" == "$p" ]] && dup=1 && break
        done
        [[ $dup -eq 0 ]] && pids+=("$p")
    done < <(pgrep -f "(^|/)((\.)?clickclickd(-wrapped)?|clickclick_rs)( |$)" 2>/dev/null || true)

    if (( ${#pids[@]} > 0 )); then
        printf '%s\n' "${pids[@]}"
    fi
}

is_daemon_running() {
    [[ -n "$(get_daemon_pids)" ]]
}

signal_daemon() {
    local sig="$1"
    local pid
    while IFS= read -r pid; do
        [[ -n "$pid" ]] && kill "-${sig}" "$pid" 2>/dev/null || true
    done < <(get_daemon_pids)
}

stop_daemon() {
    local pid
    while IFS= read -r pid; do
        [[ -n "$pid" ]] && kill "$pid" 2>/dev/null || true
    done < <(get_daemon_pids)

    local retries=20
    while is_daemon_running && (( retries > 0 )); do
        sleep 0.05
        (( retries-- ))
    done
    rm -f "$PID_FILE" 2>/dev/null || true
}

get_active_preset() {
    if [[ -f "$ACTIVE_FILE" ]]; then
        cat "$ACTIVE_FILE"
    elif [[ -L "$ACTIVE_LINK" ]]; then
        basename "$(readlink "$ACTIVE_LINK")"
    else
        echo "nk_cream"
    fi
}

ensure_presets_installed() {
    mkdir -p "$CONFIG_DIR"
    if [[ ! -d "$PRESETS_DIR" || -z "$(ls -A "$PRESETS_DIR" 2>/dev/null)" ]]; then
        mkdir -p "$PRESETS_DIR"
        for src_dir in \
            "$REPO_DIR/presets" \
            "$REPO_DIR/share/clickclick/presets" \
            "/usr/local/share/clickclick/presets" \
            "/usr/share/clickclick/presets"; do
            if [[ -d "$src_dir" && -n "$(ls -A "$src_dir" 2>/dev/null)" ]]; then
                cp -r "$src_dir"/* "$PRESETS_DIR"/
                chmod -R u+rwX "$PRESETS_DIR" 2>/dev/null || true
                break
            fi
        done
    fi
}

ensure_active_preset() {
    ensure_presets_installed
    local active_name
    active_name=$(get_active_preset)
    if [[ ! -d "${PRESETS_DIR}/${active_name}" ]]; then
        active_name="nk_cream"
        if [[ ! -d "${PRESETS_DIR}/${active_name}" ]]; then
            active_name=$(find "$PRESETS_DIR" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort | head -n 1 || echo "")
        fi
    fi
    if [[ -n "$active_name" && -d "${PRESETS_DIR}/${active_name}" ]]; then
        ln -snf "presets/${active_name}" "$ACTIVE_LINK"
        echo "$active_name" > "$ACTIVE_FILE"
    fi
}

get_sink_mode() {
    if [[ -f "$SINK_FILE" ]]; then
        cat "$SINK_FILE"
    else
        echo "direct"
    fi
}

set_sink_mode() {
    mkdir -p "$CONFIG_DIR"
    local mode="$1"
    case "$mode" in
        direct|hardware|hw)
            echo "direct" > "$SINK_FILE"
            notify_user "Audio Routing: Direct Hardware DAC (Low-Latency)"
            printf "%b[SINK]%b Audio Routing: Direct physical DAC / Headphone Amp\n" "${C_GREEN}" "${C_RESET}"
            ;;
        surround|3d|spatial)
            echo "surround" > "$SINK_FILE"
            notify_user "Audio Routing: 3D HRTF Virtual Surround (7.1)"
            printf "%b[SINK]%b Audio Routing: 3D HRTF Virtual Surround\n" "${C_CYAN}" "${C_RESET}"
            ;;
        default|system|auto)
            echo "default" > "$SINK_FILE"
            notify_user "Audio Routing: Default System Output"
            printf "%b[SINK]%b Audio Routing: Following System Default\n" "${C_YELLOW}" "${C_RESET}"
            ;;
        *)
            printf "%b[ERROR]%b Invalid sink mode '%s'. Allowed: direct, surround, default\n" "${C_RED}" "${C_RESET}" "$mode"
            exit 1
            ;;
    esac
    if is_daemon_running; then
        start_engine
    fi
}

get_volume() {
    if [[ -f "$VOLUME_FILE" ]]; then
        cat "$VOLUME_FILE"
    else
        echo "0.75"
    fi
}

set_volume() {
    mkdir -p "$CONFIG_DIR"
    local raw="$1"
    local parsed
    parsed=$(awk -v val="$raw" 'BEGIN {
        v = val + 0.0;
        if (v > 2.0) v = v / 100.0;
        if (v < 0.0) v = 0.0;
        if (v > 2.0) v = 2.0;
        printf "%.2f", v;
    }' 2>/dev/null || echo "0.75")

    echo "$parsed" > "$VOLUME_FILE"
    local pct
    pct=$(awk -v val="$parsed" 'BEGIN { printf "%d", int(val * 100 + 0.5) }' 2>/dev/null || echo "75")
    printf "%b[VOLUME]%b Volume set to: %s (%s%%)\n" "${C_GREEN}" "${C_RESET}" "$parsed" "$pct"

    # Send SIGUSR2 to hot-reload without restart
    signal_daemon USR2
}

get_humanize() {
    if [[ -f "$HUMANIZE_FILE" ]]; then
        cat "$HUMANIZE_FILE"
    else
        echo "true"
    fi
}

set_humanize() {
    mkdir -p "$CONFIG_DIR"
    local val="$1"
    local cur
    cur=$(get_humanize)
    local next="true"
    case "$val" in
        on|true|1|enable)
            next="true"
            ;;
        off|false|0|disable)
            next="false"
            ;;
        toggle)
            if [[ "$cur" == "true" ]]; then next="false"; else next="true"; fi
            ;;
    esac
    echo "$next" > "$HUMANIZE_FILE"
    if [[ "$next" == "true" ]]; then
        notify_user "Humanization: Enabled"
        printf "%b[HUMANIZE]%b Organic keystroke variation: Enabled (Pitch & Velocity jitter)\n" "${C_GREEN}" "${C_RESET}"
    else
        notify_user "Humanization: Disabled"
        printf "%b[HUMANIZE]%b Organic keystroke variation: Disabled\n" "${C_YELLOW}" "${C_RESET}"
    fi
    signal_daemon USR2
}

get_mice() {
    if [[ -f "$MICE_FILE" ]]; then
        cat "$MICE_FILE"
    else
        echo "true"
    fi
}

set_mice() {
    mkdir -p "$CONFIG_DIR"
    local val="$1"
    local cur
    cur=$(get_mice)
    local next="true"
    case "$val" in
        on|true|1|enable)
            next="true"
            ;;
        off|false|0|disable)
            next="false"
            ;;
        toggle)
            if [[ "$cur" == "true" ]]; then next="false"; else next="true"; fi
            ;;
    esac
    echo "$next" > "$MICE_FILE"
    if [[ "$next" == "true" ]]; then
        notify_user "Mouse Click Acoustics: Enabled"
        printf "%b[MICE]%b Mouse click acoustics: Enabled\n" "${C_GREEN}" "${C_RESET}"
    else
        notify_user "Mouse Click Acoustics: Disabled"
        printf "%b[MICE]%b Mouse click acoustics: Disabled\n" "${C_YELLOW}" "${C_RESET}"
    fi
    signal_daemon USR2
}

get_hardware_sink() {
    if command -v pw-dump >/dev/null 2>&1; then
        pw-dump Node 2>/dev/null | python3 -c '
import sys, json
try:
    nodes = json.load(sys.stdin)
    for n in nodes:
        props = n.get("info", {}).get("props", {})
        if props.get("media.class") == "Audio/Sink":
            name = props.get("node.name", "")
            if "virtual-surround" not in name and "effect_" not in name and "filter-chain" not in name:
                print(name)
                sys.exit(0)
except Exception:
    pass
' || echo ""
    fi
}

show_status() {
    ensure_active_preset
    local active
    active=$(get_active_preset)
    local running="No"
    local pid=""
    pid=$(get_daemon_pids | head -n 1 || true)
    if [[ -n "$pid" ]]; then
        running="Yes"
    fi
    local smode
    smode=$(get_sink_mode)
    local vol
    vol=$(get_volume)
    local vol_pct
    vol_pct=$(awk -v val="$vol" 'BEGIN { printf "%d", int(val * 100 + 0.5) }' 2>/dev/null || echo "75")
    local hum
    hum=$(get_humanize)
    local mouse
    mouse=$(get_mice)

    printf "%b=== CLICKCLICK STATUS ===%b\n" "${C_CYAN}" "${C_RESET}"
    printf "  Running:       %b%s%b %s\n" "${C_GREEN}" "$running" "${C_RESET}" "${pid:+(PID: $pid)}"
    printf "  Preset:        %b%s%b\n" "${C_CYAN}" "$active" "${C_RESET}"
    printf "  Audio Routing: %b%s%b\n" "${C_YELLOW}" "$smode" "${C_RESET}"
    printf "  Volume:        %s (%s%%)\n" "$vol" "$vol_pct"
    printf "  Humanization:  %s\n" "$hum"
    printf "  Mouse Clicks:  %s\n" "$mouse"
}

reload_stream() {
    if is_daemon_running; then
        signal_daemon USR1
        printf "%b[RELOAD]%b Stream re-anchored to audio sink (SIGUSR1).\n" "${C_GREEN}" "${C_RESET}"
        notify_user "Audio stream synchronized"
    else
        start_engine
    fi
}

list_presets() {
    ensure_active_preset
    local active
    active=$(get_active_preset)
    printf "%b[CLICKCLICK PRESETS]%b\n" "${C_CYAN}" "${C_RESET}"
    if [[ -d "$PRESETS_DIR" ]]; then
        for p in "$PRESETS_DIR"/*; do
            if [[ -d "$p" ]]; then
                local name
                name=$(basename "$p")
                if [[ "$name" == "$active" ]]; then
                    printf "  %b* %s (active)%b\n" "${C_GREEN}" "$name" "${C_RESET}"
                else
                    printf "    %s\n" "$name"
                fi
            fi
        done
    fi
}

set_preset() {
    ensure_presets_installed
    local target="$1"
    if [[ ! -d "${PRESETS_DIR}/${target}" ]]; then
        printf "%b[ERROR]%b Preset '%s' not found in %s\n" "${C_RED}" "${C_RESET}" "$target" "$PRESETS_DIR"
        notify_user "Preset '$target' not found!"
        exit 1
    fi

    ln -snf "presets/${target}" "$ACTIVE_LINK"
    echo "$target" > "$ACTIVE_FILE"

    printf "%b[PRESET]%b Switched active preset to: %b%s%b\n" "${C_GREEN}" "${C_RESET}" "${C_CYAN}" "$target" "${C_RESET}"

    if is_daemon_running; then
        stop_daemon
        start_engine
    fi
}

start_engine() {
    if ! groups "$USER" 2>/dev/null | grep -q "\binput\b"; then
        printf "%b[WARN]%b User is not in 'input' group. You may need: sudo usermod -aG input $USER\n" "${C_YELLOW}" "${C_RESET}"
    fi

    ensure_active_preset
    local active_name
    active_name=$(get_active_preset)
    
    local target_dir="${ACTIVE_LINK}"
    if [[ ! -f "${target_dir}/config.json" ]]; then
        target_dir="${CONFIG_DIR}"
    fi

    if [[ ! -f "${target_dir}/config.json" ]]; then
        printf "\n%b[ACTION REQUIRED]%b Missing config.json in preset!\n" "${C_YELLOW}" "${C_RESET}"
        notify_user "Missing config.json in preset: $active_name"
        exit 1
    fi

    if [[ -z "$BIN_PATH" || ! -x "$BIN_PATH" ]]; then
        printf "%b[BUILD]%b Compiling ClickClick daemon in Rust (Release Mode)...\n" "${C_YELLOW}" "${C_RESET}"
        cd "$REPO_DIR"
        if command -v nix-shell >/dev/null 2>&1; then
            nix-shell -p cargo rustc pkg-config alsa-lib --run "cargo build --release"
        elif command -v cargo >/dev/null 2>&1; then
            cargo build --release
        else
            printf "%b[ERROR]%b clickclickd binary and cargo not found.\n" "${C_RED}" "${C_RESET}"
            exit 1
        fi
        BIN_PATH="$REPO_DIR/target/release/clickclickd"
    fi

    local enable_mice_val
    enable_mice_val=$(get_mice)

    local sink_mode_val
    sink_mode_val=$(get_sink_mode)

    if [[ "$sink_mode_val" == "direct" ]]; then
        local hw_sink
        hw_sink=$(get_hardware_sink)
        if [[ -n "$hw_sink" ]]; then
            export PIPEWIRE_PROPS="{ target.object = \"$hw_sink\" }"
            printf "%b[AUDIO]%b Direct hardware link: %s\n" "${C_GREEN}" "${C_RESET}" "$hw_sink"
        else
            unset PIPEWIRE_PROPS 2>/dev/null || true
        fi
    elif [[ "$sink_mode_val" == "surround" ]]; then
        export PIPEWIRE_PROPS='{ target.object = "effect_input.virtual-surround-7.1-hesuvi" }'
        printf "%b[AUDIO]%b 3D Virtual Surround link\n" "${C_CYAN}" "${C_RESET}"
    else
        unset PIPEWIRE_PROPS 2>/dev/null || true
        printf "%b[AUDIO]%b Default system audio sink\n" "${C_YELLOW}" "${C_RESET}"
    fi

    local vol_val
    vol_val=$(get_volume)
    export CLICKCLICK_VOLUME="$vol_val"

    local hum_val
    hum_val=$(get_humanize)
    export CLICKCLICK_HUMANIZE="$hum_val"

    printf "%b[RUN]%b Starting ClickClick engine (Preset: %b%s%b, Routing: %s, Volume: %s)...\n" "${C_BLUE}" "${C_RESET}" "${C_CYAN}" "$active_name" "${C_RESET}" "$sink_mode_val" "$vol_val"
    notify_user "Active: $active_name ($sink_mode_val)"

    export ENABLE_TRACKPADS="$CONFIG_ENABLE_TRACKPADS"
    export ENABLE_MICE="$enable_mice_val"
    export PIPEWIRE_LATENCY="64/48000"

    stop_daemon

    nohup "$BIN_PATH" "$target_dir" >/tmp/clickclick.log 2>&1 &
    local launched_pid=$!
    echo "$launched_pid" > "$PID_FILE"
    sleep 0.25

    if is_daemon_running; then
        printf "%b[OK]%b Engine running in background (PID: %s).\n" "${C_GREEN}" "${C_RESET}" "$(get_daemon_pids | head -n 1)"
    else
        printf "%b[ERROR]%b Engine failed to start. Log output:\n" "${C_RED}" "${C_RESET}"
        tail -n 10 /tmp/clickclick.log || true
        exit 1
    fi
}

open_gui() {
    if [[ -x "$SCRIPT_DIR/clickclick-settings" ]]; then
        "$SCRIPT_DIR/clickclick-settings" &
    elif [[ -f "$REPO_DIR/ui/clickclick_gui.py" ]]; then
        python3 "$REPO_DIR/ui/clickclick_gui.py" &
    elif [[ -f "$REPO_DIR/lib/clickclick/clickclick_gui.py" ]]; then
        python3 "$REPO_DIR/lib/clickclick/clickclick_gui.py" &
    elif command -v clickclick-settings >/dev/null 2>&1; then
        clickclick-settings &
    elif [[ -x "/usr/local/bin/clickclick-settings" ]]; then
        /usr/local/bin/clickclick-settings &
    elif [[ -x "/usr/bin/clickclick-settings" ]]; then
        /usr/bin/clickclick-settings &
    else
        printf "%b[ERROR]%b GUI application (clickclick-settings) not found.\n" "${C_RED}" "${C_RESET}"
        exit 1
    fi
}

test_click() {
    ensure_active_preset
    local sound_file=""
    for cand in \
        "${ACTIVE_LINK}/space.wav" \
        "${ACTIVE_LINK}/enter.wav" \
        "${ACTIVE_LINK}/key_57.ogg" \
        "${ACTIVE_LINK}/key_28.ogg"; do
        if [[ -f "$cand" ]]; then
            sound_file="$cand"
            break
        fi
    done
    if [[ -z "$sound_file" ]]; then
        sound_file=$(find -L "${ACTIVE_LINK}" -maxdepth 1 -type f \( -name '*.wav' -o -name '*.ogg' \) 2>/dev/null | sort | head -n 1 || echo "")
    fi
    if [[ -n "$sound_file" && -f "$sound_file" ]]; then
        printf "%b[TEST]%b Playing click sample: %s\n" "${C_CYAN}" "${C_RESET}" "$sound_file"
        pw-play "$sound_file" 2>/dev/null || paplay "$sound_file" 2>/dev/null || aplay "$sound_file" 2>/dev/null || true
    else
        printf "%b[ERROR]%b No sound samples found in active preset.\n" "${C_RED}" "${C_RESET}"
    fi
}

# --- CLI DISPATCH ---
CMD="${1:-toggle}"

case "$CMD" in
    gui|settings|config)
        open_gui
        exit 0
        ;;
    list|ls)
        list_presets
        exit 0
        ;;
    preset|switch)
        if [[ -z "${2:-}" ]]; then
            list_presets
            exit 0
        fi
        set_preset "$2"
        exit 0
        ;;
    test|play)
        test_click
        exit 0
        ;;
    sink|routing)
        if [[ -z "${2:-}" ]]; then
            printf "Current Audio Routing: %s\n" "$(get_sink_mode)"
            exit 0
        fi
        set_sink_mode "$2"
        exit 0
        ;;
    vol|volume)
        if [[ -z "${2:-}" ]]; then
            printf "Current Volume: %s\n" "$(get_volume)"
            exit 0
        fi
        set_volume "$2"
        exit 0
        ;;
    humanize|pitch)
        set_humanize "${2:-toggle}"
        exit 0
        ;;
    mice|mouse)
        set_mice "${2:-toggle}"
        exit 0
        ;;
    reload|refresh)
        reload_stream
        exit 0
        ;;
    status|info)
        show_status
        exit 0
        ;;
    start)
        start_engine
        exit 0
        ;;
    restart)
        start_engine
        exit 0
        ;;
    stop)
        stop_daemon
        notify_user "Disabled"
        printf "%b[STOP]%b ClickClick stopped.\n" "${C_YELLOW}" "${C_RESET}"
        exit 0
        ;;
    toggle)
        if is_daemon_running; then
            printf "%b[TOGGLE]%b Stopping active instance...\n" "${C_YELLOW}" "${C_RESET}"
            stop_daemon
            notify_user "Disabled"
            exit 0
        else
            start_engine
        fi
        ;;
    help|--help|-h)
        printf "%bClickClick%b — Mechanical Keyboard Acoustics CLI\n" "${C_GREEN}" "${C_RESET}"
        printf "Usage: clickclick [command] [args]\n\n"
        printf "Commands:\n"
        printf "  gui               Open Libadwaita settings application\n"
        printf "  start             Start background audio engine (clickclickd)\n"
        printf "  stop              Stop background audio engine\n"
        printf "  toggle            Toggle engine on/off\n"
        printf "  status            Display engine status, routing, and volume\n"
        printf "  list              List available switch presets\n"
        printf "  preset <name>     Switch active preset (e.g. nk_cream)\n"
        printf "  volume <0-100>    Set feedback volume level\n"
        printf "  humanize [on|off] Toggle organic pitch & velocity micro-jitter\n"
        printf "  mice [on|off]     Toggle mouse button click acoustics\n"
        printf "  sink <mode>       Set routing: direct, surround, or default\n"
        printf "  test              Play a test click from active preset\n"
        exit 0
        ;;
    --version|-V|version)
        printf "clickclick 1.0.0\n"
        exit 0
        ;;
    *)
        ensure_presets_installed
        if [[ -d "${PRESETS_DIR}/${CMD}" ]]; then
            set_preset "$CMD"
        else
            printf "%b[ERROR]%b Unknown command or preset '%s'.\n" "${C_RED}" "${C_RESET}" "$CMD"
            list_presets
            exit 1
        fi
        ;;
esac
